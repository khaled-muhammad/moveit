# Airsynca Environment Configuration Template
# Copy this file to .env and update the values

# Environment Settings
DEBUG=False
ENVIRONMENT=production
SECRET_KEY=your-secret-key-here-generate-a-new-one
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost,127.0.0.1

# Database Configuration
DB_TYPE=sqlite  # or postgresql
DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL Configuration (if DB_TYPE=postgresql)
# DB_NAME=airsynca
# DB_USER=airsynca_user
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=5432
# DATABASE_URL=postgresql://airsynca_user:your_db_password@localhost:5432/airsynca

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
CHANNEL_LAYERS=default

# CORS Settings
CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000

# Email Configuration (optional)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Security Settings
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# File Upload Settings
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
MEDIA_ROOT=/opt/airsynca/backend/media

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/airsynca/app.log

# Performance Settings
CONN_MAX_AGE=60
DATABASE_POOL_SIZE=20

# Feature Flags
ENABLE_REGISTRATION=True
ENABLE_EMAIL_VERIFICATION=False
ENABLE_RATE_LIMITING=True

# Third-party Services (optional)
# SENTRY_DSN=your_sentry_dsn
# STRIPE_PUBLISHABLE_KEY=pk_test_your_key
# STRIPE_SECRET_KEY=sk_test_your_key
