[Unit]
Description=Airsynca Backend Django Application
After=network.target postgresql.service redis.service

[Service]
Type=exec
User=www-data
Group=www-data
WorkingDirectory=/opt/airsynca/moveit_backend
Environment=PATH=/opt/airsynca/moveit_backend/venv/bin
EnvironmentFile=/opt/airsynca/moveit_backend/.env

# Gunicorn configuration
ExecStart=/opt/airsynca/moveit_backend/venv/bin/gunicorn moveit.asgi:application \
    --bind 127.0.0.1:8000 \
    --workers 3 \
    --worker-class uvicorn.workers.UvicornWorker \
    --worker-connections 1000 \
    --max-requests 1000 \
    --max-requests-jitter 100 \
    --timeout 120 \
    --keep-alive 5 \
    --access-logfile - \
    --error-logfile - \
    --log-level info

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/airsynca/moveit_backend/media /var/log/airsynca

# Restart settings
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
